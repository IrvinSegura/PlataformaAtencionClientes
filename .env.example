# Copy to .env (gitignored) and adjust. docker compose reads it from this folder.

# Database: the owner runs migrations, the application connects as the restricted role
DB_OWNER_USER=supportchat_owner
DB_OWNER_PASSWORD=supportchat_owner_dev
DB_APP_USER=supportchat_app
DB_APP_PASSWORD=supportchat_app_dev

# Embeddings: hashing works offline; voyage needs an API key from https://www.voyageai.com
EMBEDDING_PROVIDER=hashing
VOYAGE_API_KEY=

# Answers: offline quotes the best source; anthropic needs an API key from https://console.anthropic.com
CHAT_MODEL_PROVIDER=offline
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Cheaper model for simple questions; false sends every question to ANTHROPIC_MODEL
ANTHROPIC_SIMPLE_MODEL=claude-haiku-5-5
MODEL_ROUTING_ENABLED=true

# Encrypts stored secrets (action signing keys, WhatsApp tokens): openssl rand -base64 32
# Required in prod; dev falls back to a fixed development key when empty
SECRETS_ENCRYPTION_KEY=

# Payments with Stripe: both empty turns payments off and every workspace stays on the free plan.
# Create the prices once with scripts/stripe-setup.sh; the webhook secret is the endpoint's whsec_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The panel's billing page, where Stripe's checkout and portal send people back
BILLING_RETURN_URL=http://localhost:5173/billing
# The panel, linked from the WhatsApp alerts sent to the owner when a customer needs a person
PANEL_URL=http://localhost:5173
# Shown on the public privacy policy (/legal/privacidad), the URL Meta asks for before publishing the app, and on the
# terms of service (/legal/terminos)
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
# Raise the version when the terms change: every operator accepts the new ones in the panel. Empty keeps the defaults
LEGAL_TERMS_VERSION=
LEGAL_TERMS_UPDATED=
# Completes "Estos términos se rigen por ..."; empty means Mexican law and the courts of Mexico City
LEGAL_JURISDICTION=
# What the assistant remembers of a returning customer (WhatsApp, email, Messenger, Instagram): their earlier
# conversations within this window. false turns the memory off for every workspace
CUSTOMER_MEMORY_ENABLED=true
CUSTOMER_MEMORY_LOOK_BACK=30d
# Users who run the platform (ids from GET /api/v1/me, comma separated): they see every workspace and can suspend one
PLATFORM_ADMIN_USER_IDS=
# The public demo at /demo, prepared with scripts/seed-demo.sh; both empty runs no demo
DEMO_WORKSPACE_ID=
DEMO_WIDGET_KEY=
# Answers the demo gives per day before handing the rest to the team
DEMO_DAILY_ANSWERS=300
