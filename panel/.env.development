# Read by Vite in `npm run dev`. Production builds set these at build time (see .env.example).

# Where sites load the widget from; the widget's dev server (widget/, npm run dev) serves it here
VITE_WIDGET_SCRIPT_URL=http://localhost:5174/widget.js
# API address the widget calls from customer sites
VITE_WIDGET_API_URL=http://localhost:8080
# Local page that simulates a customer site with the widget installed
VITE_WIDGET_DEMO_URL=http://localhost:5174
