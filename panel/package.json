{
  "name": "support-chat-panel",
  "version": "0.1.0",
  "private": true,
  "description": "Operator panel: knowledge base, conversations and widget settings",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "api:types": "openapi-typescript ../docs/openapi.json -o src/api/openapi.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "minimatch": "11.0.5",
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
