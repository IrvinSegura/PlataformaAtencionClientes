# Build-time settings of the panel (Vite inlines them into the bundle; never put secrets here).

# API base URL. Empty means the same origin as the panel (a reverse proxy routes /api to the backend).
# If the API is on another origin, add the panel's origin to the backend's CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=

# Shown in the embed snippet
VITE_WIDGET_SCRIPT_URL=https://cdn.example.com/widget.js
VITE_WIDGET_API_URL=https://api.example.com

# Optional: link to a test page with the widget installed
VITE_WIDGET_DEMO_URL=
