# One domain serves everything: the panel at /, the API at /api and the widget at /widget.js. Caddy obtains and renews
# the Let's Encrypt certificate for {$DOMAIN} by itself (a DuckDNS name works: it only needs ports 80 and 443 open).
{
	email {$ACME_EMAIL}
}

# Every backend replica (BACKEND_REPLICAS in .env), found by name in Docker's DNS and taken in turn. One that stops
# answering leaves the rotation for 30 s, and a request that could not reach it tries another
(backend) {
	dynamic a backend 8080 {
		refresh 5s
	}
	lb_policy round_robin
	lb_try_duration 5s
	fail_duration 30s
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}

	# The backend sets its own security headers and CORS. Caddy adds X-Forwarded-For and X-Forwarded-Proto, which the
	# backend trusts only from this private network, so rate limits see the visitor's real address
	handle /api/* {
		reverse_proxy {
			import backend
			# Answers and live updates are event streams: every chunk goes out at once
			flush_interval -1
		}
	}

	# The privacy policy and terms of service, public pages the backend renders with their own security headers
	handle /legal/* {
		reverse_proxy {
			import backend
		}
	}

	# Embedded on customers' sites: any page may load it, and a release reaches them within minutes
	handle /widget.js {
		root * /srv/widget
		header Cache-Control "public, max-age=300"
		header Access-Control-Allow-Origin *
		file_server
	}

	# The public demo: a fictitious shop with the widget, whose key the page takes from DEMO_WIDGET_KEY when served
	@demo path /demo /demo/
	handle @demo {
		root * /srv/demo
		rewrite * /index.html
		templates
		header Cache-Control "no-cache"
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		header Referrer-Policy strict-origin-when-cross-origin
		file_server
	}

	# The panel: a single-page app whose file names carry a hash, so they are cached for good
	handle {
		root * /srv/panel
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		header Referrer-Policy strict-origin-when-cross-origin
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
