// Grafana Alloy: the one collector on the server. It scrapes the backend's metrics and the host's, receives the
// backend's traces over OTLP and forwards everything to Grafana Cloud (free tier). The credentials live here, not in
// the backend, which only knows OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318.

// ---------------------------------------------------------------- Metrics

// The backend serves Prometheus metrics on its private management port, never on the public one
prometheus.scrape "backend" {
  job_name        = "backend"
  targets         = [{"__address__" = "backend:8081", "service" = "support-chat-platform"}]
  metrics_path    = "/actuator/prometheus"
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// CPU, memory and disk of the VM, read from the host's /proc, /sys and / mounted read-only
prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/root"

  filesystem {
    mount_points_exclude = "^/(dev|proc|run|sys|var/lib/docker/.+)($|/)"
  }
}

prometheus.scrape "host" {
  job_name        = "host"
  targets         = prometheus.exporter.unix.host.targets
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  external_labels = {"environment" = sys.env("DEPLOYMENT_ENVIRONMENT")}

  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROMETHEUS_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROMETHEUS_USER")
      password = sys.env("GRAFANA_CLOUD_API_TOKEN")
    }
  }
}

// ---------------------------------------------------------------- Traces

// Only reachable inside the compose network: the port is not published
otelcol.receiver.otlp "backend" {
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlphttp.grafana_cloud.input]
  }
}

otelcol.auth.basic "grafana_cloud" {
  username = sys.env("GRAFANA_CLOUD_OTLP_USER")
  password = sys.env("GRAFANA_CLOUD_API_TOKEN")
}

otelcol.exporter.otlphttp "grafana_cloud" {
  client {
    endpoint = sys.env("GRAFANA_CLOUD_OTLP_ENDPOINT")
    auth     = otelcol.auth.basic.grafana_cloud.handler
  }
}
