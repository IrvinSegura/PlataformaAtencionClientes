# Production settings. On the server: /opt/supportchat/.env, readable by the deploy user only (chmod 600).
# Never commit the real file; GitHub only holds the SSH key it deploys with.

# Public name: a domain of yours or a free DuckDNS one (see DUCKDNS_* below). Caddy gets its certificate.
DOMAIN=mysupport.duckdns.org
# Let's Encrypt writes here about certificate problems
ACME_EMAIL=ops@example.com

# Images published by the deploy workflow: ghcr.io/<owner>/support-chat-backend and support-chat-web
GHCR_OWNER=your-github-user
# The workflow sets the commit's tag when it deploys; latest is only for a manual start
IMAGE_TAG=latest

# Database: the owner migrates and backs up, the application connects as the restricted role.
# Generate each with: openssl rand -base64 24 | tr -d '/+='
DB_OWNER_USER=supportchat_owner
DB_OWNER_PASSWORD=
DB_APP_USER=supportchat_app
DB_APP_PASSWORD=

# Encrypts stored secrets (tokens, mailbox passwords): openssl rand -base64 32. Losing it means reconnecting every
# channel and integration, so keep a copy outside the server (a password manager).
SECRETS_ENCRYPTION_KEY=

# The public privacy policy (/legal/privacy) and terms of service (/legal/terms). The backend does not start without
# LEGAL_CONTACT_EMAIL: the policy must say where people ask about their data or ask for it to be deleted
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
# Raise the version when the terms change: every operator accepts the new ones in the panel. Empty keeps the defaults
LEGAL_TERMS_VERSION=
LEGAL_TERMS_UPDATED=
# Completes "Estos términos se rigen por ..."; empty means Mexican law and the courts of Mexico City
LEGAL_JURISDICTION=

# Answers and embeddings
CHAT_MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_SIMPLE_MODEL=claude-haiku-5-5
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=

# Payments: both empty keeps every workspace on the free plan
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# More than one backend replica: run redis with them (add replicas to COMPOSE_PROFILES, e.g. monitoring,replicas) so
# they share the rate limits. Two fit the database's 60 connections with the default pool of 20 each
#COMPOSE_PROFILES=replicas
#BACKEND_REPLICAS=2
#RATE_LIMIT_STORE=redis
#REDIS_URL=redis://redis:6379

# Monitoring with Grafana Cloud (free tier). Uncomment both lines below to run Alloy and send it traces.
#COMPOSE_PROFILES=monitoring
#OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
GRAFANA_CLOUD_PROMETHEUS_URL=
GRAFANA_CLOUD_PROMETHEUS_USER=
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_OTLP_USER=
GRAFANA_CLOUD_API_TOKEN=

# Backups to OCI Object Storage (scripts/backup.sh). The VM authenticates as itself (instance principal): no keys here.
# The namespace is shown by: oci os ns get --auth instance_principal
OCI_NAMESPACE=
OCI_BACKUP_BUCKET=supportchat-backups
# Optional: an age public key (age1...) encrypts each dump before it leaves the VM; keep the private key elsewhere
BACKUP_AGE_RECIPIENT=
# Optional: a healthchecks.io (free) URL pinged after each backup; it alerts you when a night is missed
BACKUP_PING_URL=
# The weekday (1 = Monday ... 7 = Sunday) the night's dump is also restored into a throwaway database
# (scripts/restore-test.sh); empty means Sunday, any other value turns it off
RESTORE_TEST_WEEKDAY=7

# DuckDNS: keeps <subdomain>.duckdns.org pointing at the VM (scripts/duckdns.sh). Empty with your own domain.
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# What the assistant remembers of a returning customer (WhatsApp, email, Messenger, Instagram); false turns it off
CUSTOMER_MEMORY_ENABLED=true
CUSTOMER_MEMORY_LOOK_BACK=30d
# Users who run the platform (ids from GET /api/v1/me, comma separated): they see every workspace and can suspend one
PLATFORM_ADMIN_USER_IDS=
# The public demo at /demo, prepared with deploy/demo/seed-demo.sh; both empty runs no demo
DEMO_WORKSPACE_ID=
DEMO_WIDGET_KEY=
DEMO_DAILY_ANSWERS=300
