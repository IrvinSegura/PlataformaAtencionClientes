[Unit]
Description=Support Chat: back up the database to OCI Object Storage
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
ExecStart=/opt/supportchat/scripts/backup.sh
# Plenty for a dump of a few GB; a stuck upload must not pile up with the next night's run
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
